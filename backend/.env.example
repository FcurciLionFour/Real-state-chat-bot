PORT=3000
FRONTEND_URL=http://localhost:4200

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_state_chat_bot?schema=public
REDIS_URL=redis://localhost:6379
PYTHON_SCRAPER_ENABLED=false
PYTHON_SCRAPER_BASE_URL=http://localhost:8000
PYTHON_SCRAPER_TIMEOUT_MS=15000
PYTHON_SCRAPER_INTERNAL_TOKEN=dev-python-scraper-internal-token-2026
PYTHON_SCRAPER_SOURCES=argenprop
PYTHON_SCRAPER_ALLOW_BROWSER_FALLBACK=false
SEARCH_MOCK_FALLBACK_ENABLED=false

# Local sin costo:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# Prueba real barata:
# OPENAI_API_KEY=tu_api_key_real
# OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MOCK_MODE=false

# Para validar el pipeline real sin OpenAI:
# GOOGLE_SEARCH_API_KEY=tu_google_api_key
# GOOGLE_SEARCH_ENGINE_ID=tu_google_search_engine_id
# npm run test:phase5:live
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Geocoding: local no usa red. Nominatim resuelve direcciones reales con rate limits externos.
GEOCODING_PROVIDER=local
GEOCODING_GOOGLE_API_KEY=
GEOCODING_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_MS=3500

JWT_ACCESS_SECRET=dev-access-jwt-key-material-2026-abcdef
JWT_REFRESH_SECRET=dev-refresh-jwt-key-material-2026-ghijkl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
